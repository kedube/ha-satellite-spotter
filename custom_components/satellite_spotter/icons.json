{
  "entity": {
    "binary_sensor": {
      "satellite_visible_now": {
        "default": "mdi:space-station",
        "state": {
          "off": "mdi:weather-night"
        }
      },
      "visible_pass_soon": {
        "default": "mdi:bell-ring-outline",
        "state": {
          "off": "mdi:bell-outline"
        }
      },
      "bright_pass_soon": {
        "default": "mdi:bell-badge-outline",
        "state": {
          "off": "mdi:bell-outline"
        }
      }
    },
    "calendar": {
      "visible_passes": {
        "default": "mdi:calendar-clock"
      }
    },
    "device_tracker": {
      "satellite_position": {
        "default": "mdi:satellite-variant"
      }
    },
    "sensor": {
      "next_visible_pass": {
        "default": "mdi:telescope"
      },
      "next_visible_pass_peak_elevation": {
        "default": "mdi:angle-acute"
      },
      "next_visible_pass_brightness": {
        "default": "mdi:brightness-6"
      },
      "next_visible_pass_duration": {
        "default": "mdi:timer-outline"
      },
      "next_visible_pass_cloud_cover": {
        "default": "mdi:weather-cloudy"
      },
      "next_visible_pass_rating": {
        "default": "mdi:star-outline",
        "state": {
          "great": "mdi:star",
          "good": "mdi:star-half-full",
          "poor": "mdi:weather-cloudy-alert"
        }
      },
      "next_visible_satellite_name": {
        "default": "mdi:satellite-variant"
      },
      "next_bright_pass": {
        "default": "mdi:flare"
      },
      "satellite_elevation": {
        "default": "mdi:angle-acute"
      },
      "visible_passes_next_24_hours": {
        "default": "mdi:format-list-numbered"
      },
      "orbital_elements_epoch": {
        "default": "mdi:database-clock-outline"
      }
    }
  },
  "services": {
    "get_passes": {
      "service": "mdi:format-list-checks"
    }
  }
}
